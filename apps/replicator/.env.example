# AgentX MCP endpoint + the MCP token (full-trust — reads ALL orgs via the change
# feed). This is the OTHER token, not the delivery one. Own-infra services only;
# NEVER ship it in a tenant app (web/desktop). See agentx/TOKENS.md.
AGENTX_MCP_URL=https://pluggie.app/api/mcp
AGENTX_MCP_TOKEN=agx_...

# Our own Postgres (Render Postgres or a Neon project WE own — not AgentX's).
DATABASE_URL=postgres://user:pass@host:5432/leadengine

# Poll cadence when the feed is idle (ms).
POLL_MS=5000
