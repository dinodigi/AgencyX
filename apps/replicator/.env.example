# AgentX MCP endpoint + full-trust token. NEVER ship this token in a tenant app.
AGENTX_MCP_URL=https://pluggie.app/api/mcp
AGENTX_MCP_TOKEN=agx_...

# Our own Postgres (Render Postgres or a Neon project WE own — not AgentX's).
DATABASE_URL=postgres://user:pass@host:5432/leadengine

# Poll cadence when the feed is idle (ms).
POLL_MS=5000
