# Delivery-scoped AgentX project token (server-side only — never exposed to the browser).
AGENTX_DELIVERY_TOKEN=agx_...

# Dev auth stub (until Clerk is wired): a real Clerk session JWT + its org id, so
# org-scoped reads/writes work locally. Leave unset to render the signed-out state.
AGENTX_DEV_ORG_ID=org_...
AGENTX_DEV_USER_TOKEN=eyJ...
