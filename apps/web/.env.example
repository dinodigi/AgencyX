# AgentX DELIVERY token (NOT the full-trust MCP token). Project-scoped: it
# identifies the project but can't read any org's data without the user's Clerk
# JWT. Server-side only, never exposed to the browser. See agentx/TOKENS.md.
AGENTX_DELIVERY_TOKEN=agx_...

# --- Clerk (real auth) ---
# When these are set, the app uses Clerk: sign-in UI + auth()/getToken() scope
# every AgentX call by the user's org. The publishable key is public; the secret
# key is NOT — keep it out of the client and out of git.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# IMPORTANT: AgentX's access rules key on flat `org_id` + `org_role` claims.
# In the Clerk dashboard → Sessions → Customize session token, add:
#   { "org_id": "{{org.id}}", "org_role": "{{org.role}}" }
# (or make a JWT template "agentx" and pass { template: "agentx" } to getToken()).

# --- Dev auth stub (only used when CLERK_SECRET_KEY is unset) ---
# A pasted Clerk session JWT + its org id, so org-scoped data loads before Clerk
# is wired. Leave unset to render the signed-out state.
AGENTX_DEV_ORG_ID=org_...
AGENTX_DEV_USER_TOKEN=eyJ...
