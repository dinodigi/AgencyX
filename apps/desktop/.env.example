# Desktop dev env (loaded by `pnpm dev`). Copy to apps/desktop/.env.
# AgentX DELIVERY token (NOT the MCP token). It's safe to ship in the desktop app
# because it can't read data without the user's Clerk JWT. Lets sign-in + sync
# reach AgentX. Mock scrape runs work WITHOUT it (leads just won't sync).
# See agentx/TOKENS.md.
AGENTX_DELIVERY_TOKEN=agx_...
