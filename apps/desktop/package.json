{
  "name": "@dinosales/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron scraper client — Clerk login + refresh, SQLite outbox, sync engine, self-update.",
  "author": "DinoSales <partners@dinodigi.com>",
  "repository": { "type": "git", "url": "https://github.com/dinodigi/AgencyX.git" },
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "doctor": "node doctor.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "build:node": "node build.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:node && pnpm build:renderer",
    "dev": "node dev.mjs",
    "dist": "pnpm build && electron-builder --publish never",
    "release": "pnpm build && electron-builder --publish always"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.22.0",
    "better-sqlite3": "^11.8.0",
    "electron-updater": "^6.3.9",
    "keytar": "^7.9.0",
    "playwright-core": "^1.49.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@dinosales/agentx-client": "workspace:*",
    "@dinosales/types": "workspace:*",
    "@dinosales/ui": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.7"
  }
}
